          ]
        },
        "supports_processes": {
          "$ref": "#/$defs/processList",
          "description": "Process ids as an array or semicolon-separated string.",
          "examples": [
            [
              "order-fulfilment"
            ]
          ]
        }
      },
      "additionalProperties": true
    },
    "process": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier",
          "description": "Nonblank process identifier.",
          "examples": [
            "order-fulfilment"
          ]
        },
        "name": {
          "type": "string",
          "description": "Display name; defaults to id.",
          "examples": [
            "Order fulfilment"
          ]
        },
        "criticality": {
          "$ref": "#/$defs/criticality",
          "description": "Process criticality; defaults to critical when omitted.",
          "examples": [
            "critical"
          ],
          "default": "critical"
        },
        "rto_hours": {
          "$ref": "#/$defs/hours",
          "description": "Recorded recovery-time objective in hours.",
          "examples": [
            4
          ]
        }
      },
      "additionalProperties": true
    }
  }
}
