{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "resilint",
          "version": "0.0.0",
          "informationUri": "https://github.com/chriswayneh/resilint",
          "rules": [
            {
              "id": "RL001",
              "name": "missing-notification-sla",
              "shortDescription": {
                "text": "missing notification sla"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "regulation": "DORA Art. 30(3)(b), 30(2)(f); NIS2 Art. 21(2)(d); PRA SS2/21 ch. 6",
                "regulation_note": "draft mapping, not legal advice"
              }
            },
            {
              "id": "RL002",
              "name": "missing-recovery-time",
              "shortDescription": {
                "text": "missing recovery time"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "regulation": "DORA Art. 30(2)(e), 30(3)(a); NIS2 Art. 21(2)(c); PRA SS2/21 ch. 6",
                "regulation_note": "draft mapping, not legal advice"
              }
            },
            {
              "id": "RL003",
              "name": "no-contact",
              "shortDescription": {
                "text": "no contact"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "regulation": "DORA Art. 30(2); NIS2 Art. 21(2)(d); PRA SS2/21 ch. 6",
                "regulation_note": "draft mapping, not legal advice"
              }
            },
            {
              "id": "RL004",
              "name": "no-exit-plan",
              "shortDescription": {
                "text": "no exit plan"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "regulation": "DORA Art. 28(8), Art. 30(3)(f); NIS2 Art. 21(2)(d); PRA SS2/21 ch. 10",
                "regulation_note": "draft mapping, not legal advice"
              }
            },
            {
              "id": "RL005",
              "name": "stale-or-missing-test",
              "shortDescription": {
                "text": "stale or missing test"
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "regulation": "DORA Art. 30(3)(c)-(d); NIS2 Art. 21(2)(f); PRA SS2/21 ch. 10",
                "regulation_note": "draft mapping, not legal advice"
              }
            },
            {
              "id": "RL006",
              "name": "recovery-exceeds-rto",
              "shortDescription": {
                "text": "recovery exceeds rto"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "regulation": "DORA Art. 30(2)(e), 30(3)(a); NIS2 Art. 21(2)(c); PRA SS2/21 ch. 10",
                "regulation_note": "draft mapping, not legal advice"
              }
            },
            {
